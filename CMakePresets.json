{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": [
        "gcc-base",
        "debug-base"
      ]
    },
    {
      "name": "gcc-release",
      "inherits": [
        "gcc-base",
        "release-base"
      ]
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "msvc-debug",
      "inherits": [
        "msvc-base",
        "debug-base"
      ]
    },
    {
      "name": "msvc-release",
      "inherits": [
        "msvc-base",
        "release-base"
      ]
    },
    {
      "hidden": true,
      "name": "Qt",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      },
      "vendor": {
        "qt-project.org/Qt": {
          "checksum": "wVa86FgEkvdCTVp1/nxvrkaemJc="
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "GCC Debug"
    },
    {
      "name": "gcc-debug-clean",
      "configurePreset": "gcc-debug",
      "displayName": "GCC Debug (Clean First)",
      "cleanFirst": true
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "displayName": "GCC Release",
      "cleanFirst": true
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "displayName": "MSVC Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "displayName": "MSVC Release"
    }
  ],
  "vendor": {
    "qt-project.org/Presets": {
      "checksum": "cLpPCJJMgHA20Fo6BPqanqqCtxo="
    }
  }
}